# ============================================================
#  AI Interview Bot — Backend Environment Variables
#  Copy this file to .env and fill in your values
# ============================================================

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# MongoDB — set to "memory" for in-memory dev server, or use Atlas URI
# For Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/interview-bot?retryWrites=true&w=majority
MONGO_URI=memory

# JWT — generate with: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=replace_this_with_64_random_chars
JWT_EXPIRES_IN=7d

# Google Gemini API — get key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
